{
  "name": "unique-file-creator",
  "publisher": "CodeSmith",
  "displayName": "Unique File Creator",
  "description": "Create a new file with a unique name (timestamp) in the current workspace.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unique-file-creator-vscode-extension.createFile",
        "title": "Unique File Creator: Create new file"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Unique File Creator Configuration",
      "properties": {
        "uniqueFileCreator.timestampPrefix": {
          "type": "string",
          "default": "YYYY-MM-DD-HH-mm-ss",
          "description": "The format of the timestamp prefix for new files. See moment.js documentation for format options."
        },
        "uniqueFileCreator.postfix": {
          "type": "string",
          "default": "",
          "description": "The string to append to the end of the file name."
        },
        "uniqueFileCreator.extension": {
          "type": "string",
          "default": ".md",
          "description": "The file extension for the new file."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/moment": "^2.13.0",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SeardnaSchmid/unique-file-creator-vscode-extension.git"
  },
  "dependencies": {
    "moment": "^2.30.1"
  }
}